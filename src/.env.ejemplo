# Copiar este archivo como .env (en la carpeta src/) SÓLO si querés que los comandos locales
# (npm run seed, npm run eventos, npm run backup, npm start) usen la base de Turso de producción.
# Sin .env, todo usa el archivo local data/parking.sqlite.
# El .env NO se sube al repo: el token da acceso total a la base.
TURSO_DATABASE_URL=libsql://nombre-de-la-base.turso.io
TURSO_AUTH_TOKEN=pegar-el-token-aca
