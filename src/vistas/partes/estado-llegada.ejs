<% if (reserva.estado === 'pendiente') { %>
  <p>Cuando llegues a la universidad, tocá <strong>«Llegué»</strong>.</p>
<% } else if (reserva.estado === 'llegada') { %>
  <p class="ok">✓ Registraste tu llegada a las <%= reserva.horaLlegada %> hs, a tiempo.</p>
<% } else if (reserva.estado === 'llegada_tarde') { %>
  <p class="alerta">Registraste tu llegada a las <%= reserva.horaLlegada %> hs, después de la tolerancia.</p>
<% } else if (reserva.estado === 'no_llego') { %>
  <p class="alerta">No registraste tu llegada a tiempo (antes de las <%= reserva.limite %> hs).</p>
<% } %>
