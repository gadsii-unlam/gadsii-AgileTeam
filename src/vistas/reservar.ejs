<%- include('partes/arriba', { titulo: 'Reservar' }) %>

<h1>Reservar estacionamiento</h1>

<% if (error) { %>
  <div class="mensaje error" role="alert"><%= error %></div>
<% } %>

<% if (opciones.length === 0) { %>
  <section class="estado">
    <p class="estado-principal">No hay lugares libres en las próximas 24 horas</p>
    <p>Volvé a intentar más tarde.</p>
  </section>
  <div class="acciones">
    <a class="boton secundario" href="/">Volver</a>
  </div>
<% } else { %>
  <p class="ayuda-texto">Elegí el día y la hora en que vas a llegar. Sólo te mostramos horarios con lugares libres.</p>

  <form method="post" action="/reservas" class="formulario">
    <label for="fecha">Día</label>
    <select id="fecha" name="fecha" required>
      <% for (const o of opciones) { %>
        <option value="<%= o.fecha %>" <%= o.fecha === fechaElegida ? 'selected' : '' %>><%= o.etiqueta %></option>
      <% } %>
    </select>

    <label for="hora">Hora de llegada</label>
    <select id="hora" name="hora" required>
      <option value="" disabled <%= horaElegida ? '' : 'selected' %>>Elegí una hora</option>
      <% const elegida = opciones.find((o) => o.fecha === fechaElegida) || opciones[0]; %>
      <% for (const h of elegida.horas) { %>
        <option value="<%= h.hora %>" <%= h.hora === horaElegida ? 'selected' : '' %>>
          <%= h.hora %> hs — <%= h.libres === 1 ? 'queda 1 lugar' : `quedan ${h.libres} lugares` %>
        </option>
      <% } %>
    </select>
    <p class="ayuda-texto">Tenés <%= toleranciaMin %> minutos de tolerancia desde la hora que elijas.</p>

    <div class="acciones">
      <button type="submit" class="boton primario">Realizar reserva</button>
      <a class="boton secundario" href="/">Volver</a>
    </div>
  </form>

  <script type="application/json" id="datos-opciones"><%- JSON.stringify(opciones).replace(/</g, '\\u003c') %></script>
  <script src="/js/reservar.js" defer></script>
<% } %>

<%- include('partes/abajo') %>
